             <property name="styleSheet">
              <string notr="true">#patientScrollArea{
	border:none;

}
#patientScrollArea QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

#patientScrollArea QScrollBar::handle:vertical {
    background-color: rgb(129, 191, 218);
    border-radius: 5px;
    min-height: 120px;
	min-height: 200px;
}

#patientScrollArea QScrollBar::handle:vertical:hover {
    background-color: rgb(86, 127, 145);
}

#patientScrollArea QScrollBar::add-line:vertical,
#patientScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

#patientScrollArea QScrollBar::groove:vertical {
    background: transparent;
    border: none;
    border-radius: 0px;
}
</string>
