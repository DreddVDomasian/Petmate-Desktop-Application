    border-radius: 5px;
    min-height: 120px;
	min-height: 200px;
}

#serviceHistoryScrollArea QScrollBar::handle:vertical:hover {
    background-color: rgb(86, 127, 145);
}

#serviceHistoryScrollArea QScrollBar::add-line:vertical,
#serviceHistoryScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

#serviceHistoryScrollArea QScrollBar::groove:vertical {
    background: transparent;
    border: none;
    border-radius: 0px;
}
